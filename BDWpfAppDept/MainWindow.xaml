<Window x:Class="BDWpfAppDept.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BDWpfAppDept"
        mc:Ignorable="d"
        Title="Dados do Departamento" Height="450" Width="616" Closing="Window_Closing">
    <Grid Margin="0,0,0,10">
        <Label Content="Dados do Departamento" HorizontalAlignment="Left" Margin="21,10,0,0" VerticalAlignment="Top" FontSize="24" FontWeight="Bold" Height="52" Width="300"/>
        <Label Content="Id" HorizontalAlignment="Left" Margin="21,88,0,0" VerticalAlignment="Top" Height="36" Width="78" FontSize="16"/>
        <Label Content="Nome" HorizontalAlignment="Left" Margin="21,129,0,0" VerticalAlignment="Top" Height="30" Width="78" FontSize="16"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="21,164,0,0" VerticalAlignment="Top" Height="30" Width="78" FontSize="16"/>
        <TextBox x:Name="TextBoxId" HorizontalAlignment="Left" Height="24" Margin="127,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160"/>
        <TextBox x:Name="TextBoxName" HorizontalAlignment="Left" Height="22" Margin="127,133,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" MaxLength="30"/>
        <TextBox x:Name="TextBoxEmail" HorizontalAlignment="Left" Height="22" Margin="127,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" MaxLength="30"/>
        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0,88,31,0" Height="122" VerticalAlignment="Top" HorizontalAlignment="Right" Width="162">
            <StackPanel VerticalAlignment="Top">
                <Button x:Name="ButtonRecuperar" Content="Recuperar" Height="30" Margin="0,0,0,5" Click="ButtonRecuperar_Click"/>
                <Button x:Name="ButtonSalvar" Content="Salvar" Height="30" Margin="0,0,0,5" Click="ButtonSalvar_Click"/>
                <Button x:Name="ButtonLimpar" Content="Limpar" Height="30" Click="ButtonLimpar_Click"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="DataGridDeptList" Margin="10,230,10,10" ColumnWidth="*" CanUserAddRows="False" IsReadOnly="True"/>
        <Label x:Name="LabelStatus" Content="Status" HorizontalAlignment="Left" Margin="380,19,0,0" VerticalAlignment="Top" Width="180" Height="33" FontSize="16"/>
    </Grid>
</Window>

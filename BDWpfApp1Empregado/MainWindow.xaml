<Window x:Class="BDWpfApp1Empregado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BDWpfApp1Empregado"
        mc:Ignorable="d"
        Title="MainWindow" Height="396" Width="616">
    <Grid Margin="0,0,107,109">
        <Label Content="Dados do Empregado" HorizontalAlignment="Left" Margin="21,10,0,0" VerticalAlignment="Top" FontSize="24" FontWeight="Bold" Height="52" Width="266"/>
        <Label Content="Matricula" HorizontalAlignment="Left" Margin="21,88,0,0" VerticalAlignment="Top" Height="36" Width="78" FontSize="16" RenderTransformOrigin="0.506,1.062"/>
        <Label Content="CPF" HorizontalAlignment="Left" Margin="21,129,0,0" VerticalAlignment="Top" Height="30" Width="59" FontSize="16"/>
        <Label Content="Nome" HorizontalAlignment="Left" Margin="21,164,0,0" VerticalAlignment="Top" Height="30" Width="59" FontSize="16" RenderTransformOrigin="0.511,1.874"/>
        <Label Content="Endereço" HorizontalAlignment="Left" Margin="21,215,0,0" VerticalAlignment="Top" Height="41" Width="96" FontSize="16" RenderTransformOrigin="0.509,1.737"/>
        <TextBox x:Name="TextBoxMatricula" HorizontalAlignment="Left" Height="24" Margin="127,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="141"/>
        <TextBox x:Name="TextBoxCPF" HorizontalAlignment="Left" Height="22" Margin="127,133,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="141"/>
        <TextBox x:Name="TextBoxNome" HorizontalAlignment="Left" Height="22" Margin="127,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="141"/>
        <TextBox x:Name="TextBoxEndereco" HorizontalAlignment="Left" Height="41" Margin="127,215,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" RenderTransformOrigin="0.514,0.909"/>
        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0,94,31,0" Height="162" VerticalAlignment="Top" HorizontalAlignment="Right" Width="162">
            <StackPanel Height="150" VerticalAlignment="Top">
                <Button x:Name="ButtonPesquisar" Content="Pesquisar" Height="30" Margin="0,0,0,5"/>
                <Button x:Name="ButtonSalvar" Content="Salvar" Height="30" Margin="0,0,0,5"/>
                <Button x:Name="ButtonExcluir" Content="Excluir" Height="30" Margin="0,0,0,5"/>
                <Button x:Name="ButtonLimpar" Content="Limpar" Height="30"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="DataGridEmpregadoList" Margin="2,274,-2,-73" ColumnWidth="*" CanUserAddRows="False"/>
        <Label x:Name="LabelStatus" Content="Status" HorizontalAlignment="Left" Margin="340,19,0,0" VerticalAlignment="Top" Width="115" Height="33" FontSize="16"/>
    </Grid>
</Window>
